# =============================================================================
# Production / Beget VPS — скопируйте в .env на сервере
#   cp .env.production.example .env && nano .env
# =============================================================================

# --- Домен (подставьте свой; A-записи на IP VPS в панели Beget) -------------
# Assistant: https://YOUR_DOMAIN
# n8n:       https://n8n.YOUR_DOMAIN
DOMAIN=example.com

# --- VK API -----------------------------------------------------------------
VK_ACCESS_TOKEN=your_vk_token
VK_OPEN_GROUP_ID=123456789
VK_CLOSED_GROUP_ID=987654321
VK_CONFIRMATION_CODE=your_confirmation_code
VK_API_VERSION=5.199

# --- GigaChat ---------------------------------------------------------------
GIGACHAT_CREDENTIALS=your_credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_PRO=GigaChat-Pro
GIGACHAT_MODEL_BASE=GigaChat

# --- yonote.ru --------------------------------------------------------------
YONOTE_API_KEY=your_yonote_api_key
YONOTE_BASE_URL=https://app.yonote.ru/api
YONOTE_COLLECTION_DRAFTS=uuid_коллекции_Черновики
YONOTE_DB_REPORTS=uuid_документа_базы_Отчёты
YONOTE_DB_REPORTS_COLLECTION=
YONOTE_DB_REPORTS_PROPS={"group_name":"title","meeting_date":"uuid","participants_count":"uuid","theme":"uuid","insights":"uuid","status":"uuid","created_at":"uuid"}

# --- Senler -----------------------------------------------------------------
SENLER_WEBHOOK_SECRET=your_secret
SENLER_API_TOKEN=your_token

# --- Parser (внутри docker-сети) --------------------------------------------
PARSER_API_URL=http://parser-api:8000
PARSER_DB_PATH=/app/tg_vk_parser/data/images.db
TG_VK_PARSER_ROOT=/app/tg_vk_parser
ARCHIVE_INDEX_PATH=/app/tg_vk_parser/data/archive_index.faiss
ARCHIVE_METADATA_PATH=/app/tg_vk_parser/data/archive_metadata.json
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# --- n8n / публичные URL ----------------------------------------------------
N8N_PASSWORD=change_me_strong_password
# Публичный URL n8n (Senler webhooks указывают сюда)
WEBHOOK_URL=https://n8n.example.com
N8N_SECURE_COOKIE=true

# --- Логирование ------------------------------------------------------------
LOG_LEVEL=INFO
