# =============================================================================
# PRO Women Content Assistant — пример переменных окружения
# =============================================================================
# Скопируй в .env и заполни реальными значениями:
#   cp .env.example .env
#
# .env НЕ коммитить. Секреты только здесь / в CI secrets.
#
# Структура workspace (sibling-каталоги обязательны для Docker):
#   SMM-asistant/
#     pro-women-assistant/   ← этот проект
#     tg_vk_parser/          ← архив фото + SQLite (pipeline_images)
#
# Промпты и стиль — НЕ в yonote, а в репозитории:
#   content/prompts/system_prompt.txt  — системный промпт ИИ (роль, правила, пайплайн)
#   content/prompts/style_guide.txt    — стилистический гайд бренда
#   content/prompts/digest.md          — шаблон задачи «еженедельный дайджест»
# =============================================================================

# --- VK API -----------------------------------------------------------------
# Токен сообщества с правами: wall, photos, groups, docs (и poll при опросах).
VK_ACCESS_TOKEN=your_vk_token
# Числовой ID открытой группы (без минуса); в API owner_id = -ID
VK_OPEN_GROUP_ID=123456789
# Закрытая группа для human-in-the-loop (черновик + опрос «утвердить»)
VK_CLOSED_GROUP_ID=987654321
# Строка подтверждения Callback API (если подключаете VK callbacks)
VK_CONFIRMATION_CODE=your_confirmation_code
VK_API_VERSION=5.199

# --- GigaChat ---------------------------------------------------------------
# Credentials из личного кабинета Сбера / GigaChat API
GIGACHAT_CREDENTIALS=your_credentials
# Для физлиц обычно GIGACHAT_API_PERS; для юрлиц — GIGACHAT_API_CORP / B2B
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_PRO=GigaChat-Pro
GIGACHAT_MODEL_BASE=GigaChat
# Опционально:
# GIGACHAT_MAX_RETRIES=3
# GIGACHAT_TIMEOUT=60

# --- yonote.ru (API v1: https://yonote.ru/developers?v=1) -------------------
# Токен: Настройки → API. Стиль/промпты — в content/prompts/, не в yonote.
YONOTE_API_KEY=your_yonote_api_key
# Для своего пространства: https://{project}.yonote.ru/api
YONOTE_BASE_URL=https://app.yonote.ru/api
# UUID коллекции Documents «Черновики» (documents.create → collectionId)
YONOTE_COLLECTION_DRAFTS=uuid_коллекции_Черновики
# UUID документа типа database «Отчёты» (= parentDocumentId для rows.list / transaction)
YONOTE_DB_REPORTS=uuid_документа_базы_Отчёты
# Опционально: UUID коллекции, в которой лежит эта БД (поле collectionId у row)
YONOTE_DB_REPORTS_COLLECTION=
# Карта логических имён колонок → UUID свойств (обязательна для записи/фильтра по имени)
# Узнать UUID: UI БД / documents.info по YONOTE_DB_REPORTS
YONOTE_DB_REPORTS_PROPS={"group_name":"uuid","meeting_date":"uuid","participants_count":"uuid","theme":"uuid","insights":"uuid","status":"uuid","created_at":"uuid"}

# --- Senler -----------------------------------------------------------------
# Секрет заголовка X-Senler-Secret на webhook /webhook/senler/report
SENLER_WEBHOOK_SECRET=your_secret
# Токен API Senler (сценарии / сегменты; используется в n8n и будущих интеграциях)
SENLER_API_TOKEN=your_token

# --- Parser API (tg_vk_parser) ----------------------------------------------
# URL сервиса поиска фото. В Docker: http://parser-api:8000
# Локально без Docker: http://localhost:8000
PARSER_API_URL=http://parser-api:8000
# Пути ниже — для контейнера parser-api (volume ../tg_vk_parser).
# Локально на Windows задайте абсолютные пути к sibling tg_vk_parser.
PARSER_DB_PATH=/app/tg_vk_parser/data/images.db
TG_VK_PARSER_ROOT=/app/tg_vk_parser
ARCHIVE_INDEX_PATH=/app/tg_vk_parser/data/archive_index.faiss
ARCHIVE_METADATA_PATH=/app/tg_vk_parser/data/archive_metadata.json
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# --- Telegram (Telethon; парсинг каналов в tg_vk_parser, не в assistant) ----
# Нужны только если запускаете импорт/парсинг в sibling-проекте tg_vk_parser.
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_PHONE=+79991234567

# --- Инфраструктура (docker compose / n8n) ----------------------------------
N8N_PORT=5678
N8N_PASSWORD=secure_password
# Публичный URL n8n для webhook'ов (Senler → n8n)
WEBHOOK_URL=https://your-domain.com

# --- Логирование ------------------------------------------------------------
LOG_LEVEL=INFO
